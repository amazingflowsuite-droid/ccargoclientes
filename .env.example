# Supabase Configuration
# Preencha com as credenciais do seu projeto Supabase (disponíveis em Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Chave privada de servidor (NUNCA usar prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Segredo para assinatura do cookie de sessão HttpOnly (gere uma string aleatória longa)
AUTH_SESSION_SECRET=change-this-to-a-long-random-secret

# Hostinger SMTP Configuration (Disparo direto de e-mails de criação/reset de senha)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=comercial@ccargo.com.br
SMTP_PASS=sua-senha-do-email-hostinger
SMTP_FROM="CCargo Transportes <comercial@ccargo.com.br>"
